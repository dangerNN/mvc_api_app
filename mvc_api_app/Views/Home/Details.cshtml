@model mvc_api_app.Models.Student
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Деталі студента</title>
    <style>
            body {
                font-family: 'Segoe UI', sans-serif;
                background-color: #f4f7f6;
                padding: 40px 20px;
            }

            .container {
                max-width: 500px;
                margin: 0 auto;
                background: #fff;
                padding: 24px;
                border-radius: 8px;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            }

            .detail-row {
                margin-bottom: 12px;
                font-size: 16px;
            }

                .detail-row strong {
                    color: #4f46e5;
                }

            .btn {
                padding: 8px 14px;
                border-radius: 4px;
                text-decoration: none;
                color: white;
                display: inline-block;
                margin-top: 15px;
            }

            .btn-warning {
                background-color: #f59e0b;
            }

            .btn-secondary {
                background-color: #6b7280;
            }
    </style>
</head>
<body>

    <div class="container">
        <h2>Інформація про студента</h2>
        <hr />
        <div class="detail-row"><strong>ID:</strong> @Model.Id</div>
        <div class="detail-row"><strong>Ім'я:</strong> @Model.Name</div>
        <div class="detail-row"><strong>Email:</strong> @Model.Email</div>
        <div class="detail-row"><strong>Роль:</strong> @Model.Role</div>
        <div class="detail-row">
            <strong>Статус:</strong> @(Model.Status ? "Активний" : "Неактивний")
        </div>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </div>

</body>
</html>